# =====================================================================
# DISCO-AI CONFIGURATION TEMPLATE
# =====================================================================
# Copy this file to .env and fill in your details:
# cp .env.example .env

# --- Discord Settings ---
# Get your bot token from: https://discord.com/developers/applications
DISCORD_BOT_TOKEN=your_discord_bot_token_here

# Your numeric Discord User ID (Enable Developer Mode in Discord, right-click your profile, "Copy User ID")
# Used to restrict admin commands (/facts, /reset) to yourself
BOT_OWNER_ID=your_discord_numeric_id_here

# Bot display name
BOT_NAME=Disco

# Optional: Comma-separated list of Channel or Server IDs to restrict the bot to.
# Leave blank to let the bot respond anywhere it is mentioned or DMed.
ALLOWED_CHANNEL_IDS=

# =====================================================================
# INFERENCE BACKEND (Choose ONE setup below)
# =====================================================================

# --- Option A: Local LLMs (LM Studio) [Default] ---
API_BASE_URL=http://127.0.0.1:1234/v1
MODEL_NAME=qwen3.5-4b
API_KEY=

# --- Option B: Local LLMs (Ollama) ---
# API_BASE_URL=http://127.0.0.1:11434/v1
# MODEL_NAME=qwen2.5:7b
# API_KEY=

# --- Option C: Cloud API (OpenRouter) ---
# API_BASE_URL=https://openrouter.ai/api/v1
# MODEL_NAME=meta-llama/llama-3.3-70b-instruct
# API_KEY=sk-or-v1-...

# --- Option D: Cloud API (OpenAI) ---
# API_BASE_URL=https://api.openai.com/v1
# MODEL_NAME=gpt-4o-mini
# API_KEY=sk-...

# --- Option E: Cloud API (Groq) ---
# API_BASE_URL=https://api.groq.com/openai/v1
# MODEL_NAME=llama-3.3-70b-versatile
# API_KEY=gsk_...

# =====================================================================
# SAMPLING PARAMETERS (Tuned for Qwen 3.5 4B & modern LLMs)
# =====================================================================
TEMPERATURE=0.75
TOP_P=0.80
TOP_K=20
MIN_P=0.05
REPETITION_PENALTY=1.05
MAX_TOKENS=500
